rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /movies/{movieId} {
      function isValidMovie(movie) {
        return movie.keys().hasAll([
            'title',
            'ReleaseYear',
            'ReceivedOscar'
          ])
          && movie.keys().hasOnly([
            'title',
            'ReleaseYear',
            'ReceivedOscar',
            'description',
            'runtime',
            'genre',
            'poster_url',
            'backdrop_url',
            'trailer_url',
            'average_rating',
            'mtrcb_rating',
            'cast',
            'director'
          ])
          && movie.title is string
          && movie.ReleaseYear is int
          && movie.ReceivedOscar is bool
          && (!('description' in movie) || movie.description is string)
          && (!('genre' in movie) || movie.genre is list)
          && (!('poster_url' in movie) || movie.poster_url is string)
          && (!('backdrop_url' in movie) || movie.backdrop_url is string)
          && (!('trailer_url' in movie) || movie.trailer_url is string)
          && (!('mtrcb_rating' in movie) || movie.mtrcb_rating is string)
          && (!('cast' in movie) || movie.cast is list)
          && (!('director' in movie) || movie.director is string)
          && (!('runtime' in movie) || movie.runtime is number)
          && (!('average_rating' in movie)
            || movie.average_rating is number);
      }

      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && isValidMovie(request.resource.data);
      allow delete: if request.auth != null;
    }
  }
}
